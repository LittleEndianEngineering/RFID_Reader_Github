*.py text eol=lf
# Release snapshots preserve the exact bytes covered by their checksums, including
# inherited source whitespace and the original platform test-report line endings.
releases/** -text whitespace=-blank-at-eol,cr-at-eol
# Customer executable packages use Git LFS; source/JSON/checksums stay in normal Git.
releases/**/*.exe filter=lfs diff=lfs merge=lfs -text
releases/**/*.zip filter=lfs diff=lfs merge=lfs -text
releases/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
